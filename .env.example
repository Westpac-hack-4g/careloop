# Copy to .env.local. Without a key the app runs in sample mode (scripted replies).
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5. A smaller model answers faster on stage.
CARELOOP_MODEL=
# Optional. Set to "sample" to force scripted replies even with a key.
CARELOOP_AI=
# Optional. The demo's fixed "today". Default: 2026-11-16.
CARELOOP_TODAY=
